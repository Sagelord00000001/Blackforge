# BLACKFORGE CONFIGURATION — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env or any file containing real secrets.

# Application
BLACKFORGE_APP_NAME=blackforge
BLACKFORGE_ENV=development
BLACKFORGE_LOG_LEVEL=INFO

# Data & State
BLACKFORGE_DATA_DIR=./data
BLACKFORGE_DB_PATH=./data/blackforge.db

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Options: mock | ollama | huggingface | hf
#   mock       — deterministic mock, no network, no model download
#   ollama     — local Ollama server (requires server running)
#   huggingface — local transformers (requires torch+transformers installed)
BLACKFORGE_LLM_PROVIDER=mock

# Model identifier (HuggingFace repo ID or Ollama model name)
BLACKFORGE_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
# BLACKFORGE_LLM_MODEL=Qwen/Qwen3-8B   # Recommended for T4 GPU
# BLACKFORGE_LLM_MODEL=llama3            # For Ollama

# Device: auto | cpu | cuda | mps
BLACKFORGE_LLM_DEVICE=auto

# Data type: auto | float32 | float16 | bfloat16
BLACKFORGE_LLM_DTYPE=auto

# Quantization: null | 4bit
BLACKFORGE_LLM_QUANTIZATION=

# Context and generation
BLACKFORGE_LLM_CONTEXT_LENGTH=8192
BLACKFORGE_MAX_TOKENS=2048
BLACKFORGE_LLM_TEMPERATURE=0.7

# Ollama server URL (only for provider=ollama)
BLACKFORGE_LLM_BASE_URL=http://localhost:11434

# Model download/cache
BLACKFORGE_LLM_ALLOW_DOWNLOAD=true
BLACKFORGE_LLM_CACHE_DIR=

# Remote provider keys (only for remote providers, not used with local models)
# BLACKFORGE_LLM_API_KEY=
# BLACKFORGE_LLM_API_KEY_SECONDARY=

# Timeout and retries
BLACKFORGE_LLM_TIMEOUT_SECONDS=120
BLACKFORGE_LLM_MAX_RETRIES=2

# Authorization
BLACKFORGE_AUTH_MODE=strict
BLACKFORGE_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# Execution Limits
BLACKFORGE_MAX_CONCURRENT_TASKS=5
BLACKFORGE_TASK_TIMEOUT_SECONDS=300
BLACKFORGE_MAX_EVIDENCE_ITEMS=10000

# Memory
BLACKFORGE_MEMORY_BACKEND=sqlite
BLACKFORGE_MEMORY_DB_PATH=./data/memory.db

# Mission Defaults
BLACKFORGE_DEFAULT_CONFIDENCE_THRESHOLD=0.7
