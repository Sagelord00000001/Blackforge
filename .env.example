# BLACKFORGE CONFIGURATION — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env or any file containing real secrets.

# Application
BLACKFORGE_APP_NAME=blackforge
BLACKFORGE_ENV=development
BLACKFORGE_LOG_LEVEL=INFO

# Data & State
BLACKFORGE_DATA_DIR=./data
BLACKFORGE_DB_PATH=./data/blackforge.db

# LLM Provider Configuration
BLACKFORGE_LLM_PROVIDER=ollama
BLACKFORGE_LLM_MODEL=llama3
BLACKFORGE_LLM_BASE_URL=http://localhost:11434
# BLACKFORGE_LLM_API_KEY=          # Only for remote providers
# BLACKFORGE_LLM_API_KEY_SECONDARY= # Fallback/secondary key

# Authorization
BLACKFORGE_AUTH_MODE=strict
BLACKFORGE_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# Execution Limits
BLACKFORGE_MAX_CONCURRENT_TASKS=5
BLACKFORGE_TASK_TIMEOUT_SECONDS=300
BLACKFORGE_MAX_EVIDENCE_ITEMS=10000

# Memory
BLACKFORGE_MEMORY_BACKEND=sqlite
BLACKFORGE_MEMORY_DB_PATH=./data/memory.db

# Mission Defaults
BLACKFORGE_DEFAULT_CONFIDENCE_THRESHOLD=0.7
